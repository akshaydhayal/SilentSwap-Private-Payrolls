# SilentSwap Payroll - Environment Variables
# Copy this file to .env.local for local development
# For production (Vercel), set these in the Vercel dashboard

# ============================================
# REQUIRED VARIABLES (for production)
# ============================================

# SilentSwap Environment
# Options: "staging" or "production"
# Default: staging (if not set)
# Where to get: Use "staging" for testing, "production" for mainnet
NEXT_PUBLIC_SILENTSWAP_ENV=staging

# Solana RPC URL
# Default: https://api.mainnet-beta.solana.com (if not set)
# Where to get: 
#   - Free: https://api.mainnet-beta.solana.com (public, rate-limited)
#   - Recommended: Get a free RPC from:
#     * Helius: https://www.helius.dev/ (free tier available)
#     * QuickNode: https://www.quicknode.com/ (free tier available)
#     * Alchemy: https://www.alchemy.com/solana (free tier available)
#     * Or use your own Solana RPC endpoint
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# OPTIONAL VARIABLES
# ============================================

# SilentSwap Integrator ID
# Purpose: Optional tracking ID for your swaps (for analytics)
# Default: undefined (optional)
# Where to get: Contact SilentSwap team or check their documentation
#   - This is optional and mainly for tracking/analytics
#   - You can leave this empty if you don't have one
NEXT_PUBLIC_INTEGRATOR_ID=

# WalletConnect Project ID
# Purpose: For EVM wallet connections via WalletConnect
# Default: "default" (if not set, but not recommended for production)
# Where to get: 
#   1. Go to https://cloud.walletconnect.com/
#   2. Sign up / Log in
#   3. Create a new project
#   4. Copy the Project ID
# Note: This is optional but recommended for production. 
#       Without it, WalletConnect may not work properly.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
